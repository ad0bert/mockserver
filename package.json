{
  "name": "@ad0bert/mockserver",
  "version": "1.0.1",
  "description": "Local webserver delivering file based mock responses for http requests, with a Swagger / OpenAPI mock generator",
  "keywords": [
    "mock",
    "mock-server",
    "api-mock",
    "openapi",
    "swagger",
    "http",
    "testing",
    "proxy",
    "record"
  ],
  "homepage": "https://github.com/ad0bert/mockserver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ad0bert/mockserver.git"
  },
  "bugs": {
    "url": "https://github.com/ad0bert/mockserver/issues"
  },
  "author": "Peter Ortner",
  "license": "MIT",
  "main": "mockserver.js",
  "bin": {
    "mockserver": "mockserver.js",
    "generate-mock-structure": "generate-mock-structure.js"
  },
  "files": [
    "mockserver.js",
    "lib/",
    "generate-mock-structure.js",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node mockserver.js",
    "generate": "node generate-mock-structure.js",
    "test": "node --test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p .",
    "check": "npm run lint && npm run typecheck && npm test",
    "demo": "node mockserver.js -m demo/mocks"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
